[tagpr]
	# Release candidate PRs are opened against main.
	releaseBranch = main
	# This project has no version file: the version is injected at build time
	# via goreleaser ldflags, so git tags are the only source of truth.
	versionFile = -
	vPrefix = true
	# goreleaser creates the GitHub Release; tagpr only tags.
	release = false
	# Release notes live in the GitHub Release (generated by goreleaser).
	changelog = false
